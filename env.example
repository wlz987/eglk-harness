# eglk · .env example (copy to workdir `.env`; do not commit secrets)
# Non-secret project defaults prefer `.eglk-harness/config.toml` (`eglk-harness init`).
# Aligned with design/env.example.md.

# ── 后端（亦可写在 .eglk-harness/config.toml [run]）──
# EGLK_AGENT=codex          # mock | codex | claude_code

# ── 共享模型（Codex 也可读 ~/.codex/config.toml）──
# EGLK_MODEL=Qwen3.6-35B-A3B-AWQ-4bit

# ── 按角色分级（设计意图；未接前回退 EGLK_MODEL）──
# EGLK_MODEL_MAKER=claude-opus-4.8
# EGLK_MODEL_CHECKER=claude-sonnet-4.5
# EGLK_MODEL_GOVERNOR=claude-opus-4.8
# EGLK_MODEL_EXPLORER=claude-haiku-3.5
# EGLK_MODEL_VERIFIER=claude-sonnet-4.5
# EGLK_MODEL_PRUNER=claude-haiku-3.5
# EGLK_MODEL_REFINER=claude-sonnet-4.5

# ── 编译 / 旁路 ──
# EGLK_COMPILE=auto         # auto | force | off
# EGLK_COMPILE_LLM=1        # STEP0 Adapter compile (no tools); 0=mechanical only
# EGLK_BYPASS_LLM=auto      # auto=live only; 1=force LLM bypass roles; 0=mechanical
# EGLK_SOAK_LIVE=1          # enable live soak-bypass pytest / require llm hits
# EGLK_SOAK_AGENT=codex     # backend for live soak tests
# EGLK_SWARM=0              # 0=Phase-0 soft off; 1=force Explorer; unset=触发表
# EGLK_MODEL_DOWNGRADE_THRESHOLD_USD=6.0
# EGLK_MODEL_DOWNGRADE_VERIFIER=claude-haiku-3.5
# EGLK_MODEL_DOWNGRADE_REFINER=claude-haiku-3.5

# ── 旁路语言 / 角色超时 ──
# EGLK_PROMPT_LANGUAGE=en   # en | zh
# EGLK_TIMEOUT_MAKER=600
# EGLK_TIMEOUT_CHECKER=600
# EGLK_TIMEOUT_GOVERNOR=120
# EGLK_TIMEOUT_EXPLORER=120
# EGLK_TIMEOUT_VERIFIER=120
# EGLK_TIMEOUT_REFINER=120
# EGLK_TICK_TIMEOUT=600     # host per-tick await (live default 600; long runs may need 4000+)
# EGLK_COGNITIVE_TOKENS_MAX=64000  # or set [limits] in config.toml (Codex often needs 500000+)
# EGLK_PLUGINS_ROOT=~/.eglk-harness/plugins

# ── MCP / Computer-Use（opt-in；会话角色默认可持；run 永不自动装插件）──
# EGLK_MCP_CONFIG=/path/to/mcp.json
# EGLK_MCP_ADD_DIRS=/path/to/extra
# EGLK_MCP_ALLOW_DEFAULT=*
# EGLK_MCP_ALLOW_GOVERNOR=search
# EGLK_MCP_ALLOW_EXPLORER=none
# EGLK_TOOLS_OFF_ROLES=compile
# eglk-harness plugin list
# eglk-harness plugin install --name codex-computer-use
# eglk-harness doctor --install-codex-gui

# ── API（live backends）──
# EGLK_BASE_URL=http://127.0.0.1:18000/v1   # Codex -c model_providers.eglk_harness (never :28000)
# EGLK_API_KEY=sk-...
# EGLK_WIRE_API=responses
# OPENAI_API_KEY=...                        # also accepted
# OPENAI_BASE_URL=...
# EGLK_API_TIMEOUT=120
