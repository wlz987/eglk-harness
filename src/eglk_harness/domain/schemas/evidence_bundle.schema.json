{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://eglk.local/schemas/evidence_bundle.schema.json",
 "title": "EvidenceBundle",
 "description": "Checker's independent, read-only audit product for one WorkContract. No production ground truth; per-obligation typed verdicts replace the legacy single audit_progress float. See ../semantic_core.md §6, ../gate_policy.md §1.",
 "type": "object",
 "additionalProperties": false,
 "required": [
 "schema", "evidence_id", "contract_ref", "checker_session_id",
 "world_revision", "verdicts", "integrity_violation", "additional_gaps"
 ],
 "properties": {
 "schema": { "type": "string", "const": "eglk.evidence_bundle" },
 "evidence_id": { "type": "string", "minLength": 1 },
 "contract_ref": { "type": "string", "minLength": 1 },
 "checker_session_id": { "type": "string", "minLength": 1 },
 "world_revision": { "type": "integer", "minimum": 0 },
 "verdicts": {
 "type": "array",
 "minItems": 1,
 "items": { "$ref": "#/$defs/ObligationVerdict" }
 },
 "integrity_violation": {
 "type": "boolean",
 "description": "True when the Checker (or its tool chain) mutated task-relevant world state during audit. Forces all verdicts in this bundle to be treated as unsatisfied regardless of their own status."
 },
 "additional_gaps": {
 "type": "array",
 "items": { "type": "string", "minLength": 1 },
 "description": "Non-obligation boundary gaps, e.g. 'boundary:forbidden_path_touched'."
 }
 },
 "$defs": {
 "ObligationVerdict": {
 "type": "object",
 "additionalProperties": false,
 "required": ["obligation_id", "status", "attestations", "gaps", "defect_suspected"],
 "properties": {
 "obligation_id": { "type": "string", "minLength": 1 },
 "status": { "type": "string", "enum": ["satisfied", "unsatisfied", "indeterminate"] },
 "attestations": {
 "type": "array",
 "items": { "$ref": "#/$defs/Attestation" }
 },
 "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
 "defect_suspected": {
 "type": "boolean",
 "description": "Set true ONLY for derived (non-root) obligations whose statement itself appears wrong/impossible. Triggers a Governor ObligationAmendment proposal (see ../semantic_core.md §4); never bypasses obligation reduction directly to admit."
 }
 },
 "if": { "properties": { "status": { "const": "satisfied" } } },
 "then": { "properties": { "attestations": { "minItems": 1 } } }
 },
 "Attestation": {
 "type": "object",
 "additionalProperties": false,
 "required": ["method", "world_revision", "digest", "observer", "raw_ref", "watch_set"],
 "properties": {
 "method": {
 "type": "string",
 "enum": ["file_exists", "file_content_match", "command_exit", "api_state", "structured_diff", "custom_attestation"]
 },
 "world_revision": { "type": "integer", "minimum": 0 },
 "digest": { "type": "string", "minLength": 1 },
 "observer": { "type": "string", "minLength": 1 },
 "raw_ref": { "type": "string", "minLength": 1 },
 "watch_set": {
 "type": "array",
 "items": { "type": "string", "minLength": 1 },
 "description": "Resource refs this proof depends on; used by ObligationInvalidated detection (semantic_core.md §7)."
 }
 }
 }
 }
}
