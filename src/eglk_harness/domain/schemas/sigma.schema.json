{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eglk.local/schemas/sigma.schema.json",
  "title": "Sigma",
  "type": "object",
  "additionalProperties": false,
  "required": ["active", "archived", "reasoning_log"],
  "properties": {
    "active": {
      "type": "array",
      "items": { "$ref": "#/$defs/sigma_item" }
    },
    "archived": {
      "type": "array",
      "items": { "$ref": "#/$defs/sigma_item" }
    },
    "reasoning_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tick", "alternatives", "rejected", "why"],
        "properties": {
          "tick": { "type": "integer", "minimum": 0 },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "rejected": { "type": "array", "items": { "type": "string" } },
          "why": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "sigma_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cond", "wrong", "correct", "conf", "verifications", "last_used"],
      "properties": {
        "id": { "type": "string" },
        "cond": { "type": "string" },
        "wrong": { "type": "string" },
        "correct": { "type": "string" },
        "conf": { "type": "number", "minimum": 0, "maximum": 1 },
        "verifications": { "type": "integer", "minimum": 0 },
        "last_used": { "type": "integer", "minimum": 0 },
        "merged_from": { "type": "array", "items": { "type": "string" } },
        "status": {
          "type": "string",
          "description": "lifecycle status for ARCHIVED items (superseded by a merge, frozen, or falsified by new evidence)",
          "enum": ["superseded", "frozen", "falsified"]
        }
      }
    }
  }
}
