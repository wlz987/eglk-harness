{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eglk.local/schemas/tick.schema.json",
  "title": "Tick",
  "description": "One archived tick as written by context_compress.archive_tick (ticks.jsonl). NOTE: this is the runtime record; it embeds the Gate decision but NOT the raw claim/evidence blobs (those live in claims/ and evidence/). The decision object is inlined (no cross-file $ref) so it validates standalone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tick", "tree", "decision"],
  "properties": {
    "tick": { "type": "integer", "minimum": 0 },
    "tree": { "type": "object" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "maker_progress", "checker_progress", "perception_gap", "gaps_count", "should_run_next"],
      "properties": {
        "decision": { "type": "string", "enum": ["admit", "repair", "abort"] },
        "reason": { "type": "string" },
        "maker_progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "checker_progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "perception_gap": { "type": "number", "minimum": 0, "maximum": 1 },
        "gaps_count": { "type": "integer", "minimum": 0, "description": "未满足条件的计数（frontend ev.gaps 的语义）" },
        "next_action": { "type": ["string", "null"] },
        "should_run_next": { "type": "boolean" },
        "subgoal_id": { "type": "string" },
        "tick": { "type": "integer", "minimum": 0 }
      }
    },
    "quota": { "type": "object" },
    "swarm_enabled": { "type": "object" },
    "world_digest": { "type": ["string", "null"] }
  }
}
