{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eglk.local/schemas/task_spec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["instance_id", "instruction", "limits"],
  "properties": {
    "instance_id": { "type": "string", "minLength": 1 },
    "instruction": { "type": "string", "minLength": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cognitive_tokens_max", "repairs_max"],
      "properties": {
        "cognitive_tokens_max": { "type": "integer", "minimum": 1 },
        "repairs_max": { "type": "integer", "minimum": 0 },
        "usd_soft": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
