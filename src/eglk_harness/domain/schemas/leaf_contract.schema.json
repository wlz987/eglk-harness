{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eglk.local/schemas/leaf_contract.schema.json",
  "title": "LeafContract",
  "description": "当前 in_progress 叶装配进 Maker/Checker prompt 的有界契约。运行时由树节点 + Σ/feedback 合成，可选落盘；若落盘则校验本 schema。装配步骤见 ../multi_agent.md §5.0；理念见 ../../philosophy.md §5.1。",
  "type": "object",
  "additionalProperties": false,
  "required": ["leaf_id", "goal", "acceptance", "boundary", "prior_evidence"],
  "properties": {
    "leaf_id": {
      "type": "string",
      "minLength": 1,
      "description": "对应 subgoals_tree 叶节点 id。"
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "description": "装配时的 tick（可选审计字段）。"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "本叶一句话目标；通常取自节点 title。"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "可核验完成标准；通常取自 done_criteria。隐式多条件应拆成多条或触发 split。"
    },
    "boundary": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "不可越界约束：禁改测、勿提前破坏 before 态、禁区路径、来自 .goal.md / Σ 的硬约束。"
    },
    "prior_evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["sigma", "gap", "feedback", "challenge", "artifact_ref", "other"]
              },
              "text": { "type": "string", "minLength": 1 },
              "ref": { "type": "string", "description": "可选：σ_id / tick / path" }
            }
          }
        ]
      },
      "description": "相关已核验事实或上轮未决议题（Σ.active、gaps、feedback_for、verifier challenges）。"
    },
    "parent_id": {
      "type": ["string", "null"]
    },
    "attempt_index": {
      "type": "integer",
      "minimum": 0,
      "description": "本叶已尝试次数（含当前）。"
    }
  }
}
