{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eglk.local/schemas/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "tick",
    "maker_session_id",
    "kind",
    "done_progress",
    "confidence",
    "alternatives",
    "payload",
    "step_review"
  ],
  "properties": {
    "claim_id": { "type": "string", "minLength": 1 },
    "tick": { "type": "integer", "minimum": 0 },
    "maker_session_id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["patch", "actions", "commands", "mixed", "files"]
    },
    "done_progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "subgoals_hit": {
      "type": "array",
      "items": { "type": "string" }
    },
    "shortcut_hit": { "type": "boolean" },
    "alternatives_missing": { "type": "boolean" },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "status"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["adopt", "reject"] },
              "reason": { "type": "string" }
            }
          }
        ]
      }
    },
    "payload": { "type": "object" },
    "step_review": {
      "type": "object",
      "additionalProperties": false,
      "description": "本叶这一步的显式自评：得失 / 收益 / 风险。Gate 不据此判真值，但 schema 强制 Maker 写出。",
      "required": ["gains", "losses", "benefits", "risks"],
      "properties": {
        "gains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "得：本步实际获得什么（能力、产物、信息）"
        },
        "losses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "失：为做本步放弃或推迟了什么"
        },
        "benefits": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "收益：对本叶/总目标的正向回报"
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "风险：残留不确定性、副作用、回滚成本"
        }
      }
    },
    "skill_proposal": { "type": "string" },
    "rationale_ref": { "type": ["string", "null"] },
    "subgoal_id": { "type": "string" },
    "attempt_index": { "type": "integer", "minimum": 0 },
    "note": { "type": "string" }
  }
}
