{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://eglk.local/schemas/work_contract.schema.json",
 "title": "WorkContract",
 "description": "Immutable per-node execution contract assembled by the Scheduler when a node transitions ready -> in_progress. See ../semantic_core.md §3 and ../multi_agent.md §3.",
 "type": "object",
 "additionalProperties": false,
 "required": [
 "schema", "contract_id", "node_id", "world_revision_base",
 "obligation_refs", "dependencies", "boundary", "capabilities",
 "transaction_policy", "budget", "prior_evidence_refs"
 ],
 "properties": {
 "schema": { "type": "string", "const": "eglk.work_contract" },
 "contract_id": { "type": "string", "minLength": 1 },
 "node_id": { "type": "string", "minLength": 1 },
 "world_revision_base": { "type": "integer", "minimum": 0 },
 "obligation_refs": {
 "type": "array",
 "minItems": 1,
 "items": { "type": "string", "minLength": 1 }
 },
 "dependencies": {
 "type": "array",
 "items": { "type": "string", "minLength": 1 },
 "description": "node_ids whose depends_on edge into this node is already satisfied."
 },
 "boundary": {
 "type": "object",
 "additionalProperties": false,
 "required": ["allowed_scope", "forbidden_actions"],
 "properties": {
 "allowed_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
 "forbidden_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
 }
 },
 "capabilities": {
 "type": "array",
 "items": { "type": "string", "minLength": 1 },
 "description": "Subset of CapabilityManifest entry ids authorized for this contract."
 },
 "transaction_policy": {
 "type": "object",
 "additionalProperties": false,
 "required": ["side_effect_class_ceiling"],
 "properties": {
 "side_effect_class_ceiling": {
 "type": "array",
 "items": { "type": "string", "enum": ["read_only", "reversible", "compensatable", "irreversible"] },
 "minItems": 1,
 "description": "Union of side-effect classes this contract may declare; anything above the ceiling is capability_ceiling_exceeded."
 }
 }
 },
 "budget": {
 "type": "object",
 "additionalProperties": false,
 "required": ["cognitive_tokens_soft"],
 "properties": {
 "cognitive_tokens_soft": { "type": "integer", "minimum": 0 }
 }
 },
 "prior_evidence_refs": {
 "type": "array",
 "items": { "type": "string", "minLength": 1 }
 }
 }
}
