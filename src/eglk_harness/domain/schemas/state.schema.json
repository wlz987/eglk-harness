{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eglk.local/schemas/state.schema.json",
  "title": "LoopKernelState",
  "description": "The runtime state.json written by orchestrator.init_run (kernel_common.DEFAULT_QUOTA / DEFAULT_LIMITS).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "goal_ref",
    "goal_source_ref",
    "goal_id",
    "revision",
    "world_ref",
    "sigma",
    "quota",
    "limits"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^eglk.state$"
    },
    "goal_ref": {
      "type": "string"
    },
    "goal_compiled": {
      "description": "STEP 0 compile metadata (state.md §4): how .goal.md was compiled to .goal_format.md; null when compilation is off.",
      "type": ["object", "null"],
      "properties": {
        "mode": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "model": {
          "type": ["string", "null"]
        },
        "cached": {
          "type": "boolean"
        }
      }
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "world_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "revision",
        "meta"
      ],
      "properties": {
        "snapshot": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "meta": {
          "type": "object"
        }
      }
    },
    "sigma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "archived",
        "reasoning_log"
      ],
      "properties": {
        "active": {
          "type": "array"
        },
        "archived": {
          "type": "array"
        },
        "reasoning_log": {
          "type": "array"
        }
      }
    },
    "quota": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "goal_source_ref": {
      "type": "string"
    }
  }
}
