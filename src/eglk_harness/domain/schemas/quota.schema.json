{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eglk.local/schemas/quota.schema.json",
  "title": "Quota",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cognitive_tokens",
    "cognitive_tokens_max",
    "uncertainty",
    "focus_score",
    "repairs_used",
    "repairs_max",
    "usd_used"
  ],
  "properties": {
    "cognitive_tokens": { "type": "integer", "minimum": 0 },
    "cognitive_tokens_max": { "type": "integer", "minimum": 1 },
    "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
    "focus_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "repairs_used": { "type": "integer", "minimum": 0 },
    "repairs_max": { "type": "integer", "minimum": 0 },
    "usd_used": { "type": "number", "minimum": 0 },
    "usd_soft": { "type": ["number", "null"], "minimum": 0 }
  }
}
